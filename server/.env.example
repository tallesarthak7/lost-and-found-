# Server Configuration
PORT=3001

# Database (Leave empty to use automatic embedded persistent MongoDB, or specify external MongoDB URL)
DATABASE_URL=
DATABASE_NAME=campus-lost-and-found

# JWT Secret & TTL
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION_TTL=30d

# Admin seed credentials (auto-created on first run)
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=adminpassword
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Admin

# Gemini AI (for image characteristics & specifications auto-fill)
GEMINI_API_KEY=your_gemini_api_key_here
