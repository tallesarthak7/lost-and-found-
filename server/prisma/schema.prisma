datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstname    String
  lastname     String
  email        String    @unique
  password     String
  role         String    @default("user")
  phone        String?
  profileImage String?   @map("profile_image")
  isBlocked    Boolean   @default(false) @map("is_blocked")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          Item[]   @relation("UserItems")
  verifiedItems  Item[]   @relation("UserVerifiedItems")
  claims         Claim[]  @relation("UserClaims")
  reviewedClaims Claim[]  @relation("UserReviewedClaims")

  @@map("users")
}

model Item {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String
  category        String
  type            String
  location        String
  date            DateTime  @db.Timestamptz(6)
  imageURL        String?   @map("image_url")
  postedById      String    @map("posted_by") @db.Uuid
  postedBy        User      @relation("UserItems", fields: [postedById], references: [id], onDelete: Cascade)
  status          String    @default("pending")
  verifiedByAdmin Boolean   @default(false) @map("verified_by_admin")
  verifiedById    String?   @map("verified_by") @db.Uuid
  verifiedBy      User?     @relation("UserVerifiedItems", fields: [verifiedById], references: [id], onDelete: SetNull)
  keywords        String[]  @default([])
  coordinatesLat  Float?    @map("coordinates_lat")
  coordinatesLng  Float?    @map("coordinates_lng")
  isFlagged       Boolean   @default(false) @map("is_flagged")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  claims       Claim[]
  lostMatches  Match[]   @relation("LostItemMatches")
  foundMatches Match[]   @relation("FoundItemMatches")

  @@map("items")
}

model Match {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lostItemId  String   @map("lost_item_id") @db.Uuid
  lostItem    Item     @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItemId String   @map("found_item_id") @db.Uuid
  foundItem   Item     @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)
  matchScore  Float    @map("match_score")
  matchReason String?  @map("match_reason")
  status      String   @default("suggested")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  claims Claim[]

  @@map("matches")
}

model Claim {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  matchId      String?   @map("match_id") @db.Uuid
  match        Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  claimedById  String    @map("claimed_by") @db.Uuid
  claimedBy    User      @relation("UserClaims", fields: [claimedById], references: [id], onDelete: Cascade)
  message      String
  proofImages  String[]  @default([]) @map("proof_images")
  contactInfo  String    @map("contact_info")
  status       String    @default("pending")
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedBy   User?     @relation("UserReviewedClaims", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?   @map("review_note")
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("claims")
}
